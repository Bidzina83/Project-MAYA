#!/usr/bin/env python3
import sys, os, json

def usage():
    print("usage: memoryctl registry list --storage-root <path>")
    sys.exit(2)

if __name__ == '__main__':
    if len(sys.argv) < 2:
        usage()
    cmd = sys.argv[1:]
    if cmd[0] == 'registry' and len(cmd) >= 2 and cmd[1] == 'list':
        # parse --storage-root
        if '--storage-root' in cmd:
            idx = cmd.index('--storage-root')
            try:
                storage = cmd[idx+1]
            except IndexError:
                usage()
        else:
            usage()
        regpath = os.path.join(storage, 'registry', 'memory_registry.json')
        if not os.path.exists(regpath):
            print('[]')
            sys.exit(0)
        with open(regpath, 'r', encoding='utf-8') as f:
            try:
                j = json.load(f)
            except Exception:
                j = {}
        # print JSON array of entries
        out = list(j.values())
        print(json.dumps(out))
        sys.exit(0)
    else:
        usage()
