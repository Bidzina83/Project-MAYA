{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MemoryRecord",
  "type": "object",
  "required": ["chunk_id", "text", "metadata"],
  "properties": {
    "chunk_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "text": {"type": "string"},
    "vector": {
      "type": "array",
      "items": {"type": "number"}
    },
    "metadata": {"$ref": "provenance.schema.json"}
  },
  "additionalProperties": false
}
