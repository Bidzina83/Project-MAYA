{
  "schema_version": 2,
  "product": {
    "edition": "enterprise",
    "instance_id": "${MAYA_INSTANCE_ID}"
  },
  "deployment": {
    "class": "desktop",
    "network_policy": "enterprise-byo",
    "data_dir": "${MAYA_DATA_DIR}"
  },
  "runtime": {
    "hermes_compatibility": ">=0.1",
    "enabled_profiles": [
      "maya-core",
      "maya-messaging"
    ]
  },
  "broker": {
    "mode": "disabled",
    "endpoint": null
  },
  "llm": {
    "mode": "customer_owned",
    "provider": "openai",
    "model": "gpt-4.1",
    "credential_ref": "secret://llm/openai",
    "endpoint": null,
    "timeout_seconds": 60
  },
  "integrations": {
    "google": {
      "enabled": true,
      "credential_mode": "customer_owned",
      "credential_ref": "secret://integrations/google"
    },
    "slack": {
      "enabled": true,
      "credential_mode": "customer_owned",
      "credential_ref": "secret://integrations/slack"
    },
    "telegram": {
      "enabled": true,
      "credential_mode": "customer_owned",
      "credential_ref": "secret://integrations/telegram"
    }
  },
  "memory": {
    "hermes_provider": "local",
    "retriever": "local_json",
    "registry": "sqlite",
    "governance_enabled": true
  },
  "governance": {
    "policy_file": "${MAYA_DATA_DIR}/governance/policies/enterprise-default.json",
    "audit_enabled": true,
    "default_action": "deny",
    "minimum_memory_trust": 0.7
  },
  "metabase": {
    "enabled": false,
    "deployment": "disabled",
    "endpoint": null,
    "application_database": null,
    "analytics_sources": []
  },
  "local_api": {
    "bind": "127.0.0.1",
    "port": 8765,
    "remote_access": false
  }
}
