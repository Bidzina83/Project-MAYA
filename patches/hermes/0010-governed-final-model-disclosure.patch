-_EXECUTION_KINDS = (LLM_EXECUTION_MIDDLEWARE, TOOL_EXECUTION_MIDDLEWARE, TOOL_RESULT_MIDDLEWARE)
+_EXECUTION_KINDS = (LLM_EXECUTION_MIDDLEWARE, TOOL_EXECUTION_MIDDLEWARE, TOOL_RESULT_MIDDLEWARE, MODEL_OUTPUT_MIDDLEWARE)
 
 
 class MandatoryMiddlewareError(RuntimeError):
@@ -324,6 +326,33 @@ def run_tool_result_middleware(tool_name: str, args: Dict[str, Any], result: Any
         raise MandatoryMiddlewareError("callback_failed") from None
 
 
+def run_model_output_middleware(result: Any, **context: Any) -> Any:
+    """Validate a model disclosure without permitting middleware replacement.
+
+    The caller owns the effective assembled payload. The required callback runs
+    last and cannot turn a denied disclosure into a transformed success.
+    """
+    if not _mandatory_enabled:
+        return result
+    try:
+        if not validate_mandatory_middleware():
+            raise MandatoryMiddlewareError("gate_missing")
+        required = _mandatory_callbacks[MODEL_OUTPUT_MIDDLEWARE]
+        callbacks = _get_middleware_callbacks(MODEL_OUTPUT_MIDDLEWARE)
+        callbacks = [callback for callback in callbacks if callback != required] + [required]
+        for callback in callbacks:
+            checked = callback(**middleware_payload(result=deepcopy(result), **context))
+            if not validate_mandatory_middleware():
+                raise MandatoryMiddlewareError("gate_missing")
+            if checked != result:
+                raise MandatoryMiddlewareError("callback_failed")
+        return result
+    except MandatoryMiddlewareError as exc:
+        raise MandatoryMiddlewareError(str(exc)) from None
+    except Exception:
+        raise MandatoryMiddlewareError("callback_failed") from None
+
+
 async def run_llm_execution_middleware_async(
