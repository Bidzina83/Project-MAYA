+    def _clear_owned_reset_security_candidate(self, preparation) -> None:
+        """Exact source-candidate reset boundary; ordinary cleanup is not a gate."""
+        from hermes_cli.middleware import mandatory_middleware_enabled, MandatoryMiddlewareError
+        from project_maya.hermes_plugins.reset_publication import CandidateResetPreparation
+        from tools import approval, slash_confirm
+        if (not mandatory_middleware_enabled() or type(preparation) is not CandidateResetPreparation
+                or getattr(self, "_maya_reset_preparation", None) is not preparation
+                or preparation._runner is not self or self._session_db is not preparation.reset.database
+                or preparation._phase != "acknowledging" or preparation._current is None
+                or getattr(preparation.store, "_maya_reset_preparation", None) is not preparation):
+            raise MandatoryMiddlewareError("governance.reset_security_invalid")
+        preparation._current.check()
+        key = preparation.reset.binding.route_slot
+        try:
+            # Native APIs cancel blocked waits and remove route-scoped allowances.
+            approval.clear_session(key)
+            approval.unregister_gateway_notify(key)
+            slash_confirm.clear(key)
+            for name in ("_pending_approvals", "_update_prompt_pending", "_pending_skills_reload_notes"):
+                state = getattr(self, name, None)
+                if state is not None:
+                    if type(state) is not dict:
+                        raise ValueError("invalid security state")
+                    state.pop(key, None)
+            with approval._lock, slash_confirm._lock:
+                if (key in approval._session_approved or key in approval._session_yolo
+                        or key in approval._pending or key in approval._gateway_queues
+                        or key in approval._gateway_notify_cbs
+                        or key in slash_confirm._pending):
+                    raise ValueError("uncleared security state")
+            preparation._current.check()
+        except MandatoryMiddlewareError:
+            raise
+        except Exception:
+            raise MandatoryMiddlewareError("governance.reset_security_failed") from None
 
