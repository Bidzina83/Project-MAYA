+# Opt-in only. Do not publish a Maya compatibility marker until auxiliary and
+# worker paths have also been qualified against the built runtime artifact.
+_mandatory_enabled = False
+_mandatory_callbacks: Dict[str, Callable] = {}
+_EXECUTION_KINDS = (LLM_EXECUTION_MIDDLEWARE, TOOL_EXECUTION_MIDDLEWARE)
+
+
+class MandatoryMiddlewareError(RuntimeError):
+    """Fixed, secret-safe failure; callers must not retry or fall back."""
+
+
+def enable_mandatory_middleware() -> None:
+    """Require both execution gates for the lifetime of this process.
+
+    The host must opt in before plugin discovery or agent construction. There
+    is deliberately no runtime disable/reset API: unloading plugins must deny.
+    """
+    global _mandatory_enabled
+    _mandatory_enabled = True
+
+
+def require_middleware(kind: str, callback: Callable) -> None:
+    """Bind one host-required callback per execution boundary."""
+    if kind not in _EXECUTION_KINDS or not callable(callback):
+        raise MandatoryMiddlewareError("mandatory_middleware.invalid_binding")
+    enable_mandatory_middleware()
+    previous = _mandatory_callbacks.get(kind)
+    if previous is not None and previous != callback:
+        raise MandatoryMiddlewareError("mandatory_middleware.binding_replaced")
+    _mandatory_callbacks[kind] = callback
+
+
+def validate_mandatory_middleware() -> bool:
+    """Validate live registration, not just an earlier discovery snapshot."""
+    if not _mandatory_enabled:
+        return False
+    for kind in _EXECUTION_KINDS:
+        required = _mandatory_callbacks.get(kind)
+        if required is None or _get_middleware_callbacks(kind).count(required) != 1:
+            return False
+    return True
+
+
+def _execution_callbacks(kind: str) -> List[Callable]:
+    callbacks = _get_middleware_callbacks(kind)
+    if _mandatory_enabled:
+        if not validate_mandatory_middleware():
+            raise MandatoryMiddlewareError("mandatory_middleware.gate_missing")
+        required = _mandatory_callbacks[kind]
+        # Request transformations precede authorization of the effective payload.
+        callbacks = [cb for cb in callbacks if cb != required] + [required]
+    return callbacks
+
 
