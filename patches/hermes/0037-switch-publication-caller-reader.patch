+"""Source-only initial-switch publication and guarded caller confirmation."""
+from contextlib import contextmanager
+from os import getpid
+from threading import Lock, get_ident
+from types import MappingProxyType
+
+from ..audit import AuditRecord
+from .governance import GovernanceBoundaryError, _current_task, _session_write
+from .session_creation import _digest
+from .session_requests import ACKNOWLEDGEMENT
+from .session_switch import CandidateNativeSessionSwitch
+
+CONTRACT = "project-maya.switch-caller-acknowledgement.v1"
+
+
+def _history(conn, source, target):
+    # Select the historical operations explicitly: A now has two receipts.
+    rows = conn.execute("SELECT * FROM maya_session_transitions_v1 WHERE "
+        "(operation='create' AND target_session=?) OR (operation='reset' AND target_session=?) "
+        "ORDER BY operation", (target, source)).fetchall()
+    if len(rows) != 2:
+        raise GovernanceBoundaryError("governance.switch_lineage_invalid")
+    return tuple(tuple(row) for row in rows)
+
+
+def validate_switch_lineage(conn, binding, target, expected="caller_acknowledged"):
+    """Validate current correlation and immutable history, not historical routing."""
+    route = conn.execute("SELECT session_id,route_version,correlation_id,principal "
+        "FROM maya_session_routes_v1 WHERE route_slot=?", (binding.route_slot,)).fetchone()
+    if route is None or tuple(route[:2]) != (target, 3) or route[3] != binding.owner.actor_id:
+        raise GovernanceBoundaryError("governance.switch_lineage_invalid")
+    current = conn.execute("SELECT * FROM maya_session_transitions_v1 WHERE correlation_id=?",
+                           (route[2],)).fetchone()
+    projection = conn.execute("SELECT generation,projection_hash FROM maya_session_projection_v1 "
+                              "WHERE singleton=1").fetchone()
+    if (current is None or projection is None
+            or tuple(current[2:10]) != (binding.owner.actor_id, binding.binding_version,
+                                       "switch", target, 2, 3, expected, projection[0])
+            or current[10] != projection[1]
+            or current[11] != "sha256:" + _digest(current[0].encode())):
+        raise GovernanceBoundaryError("governance.switch_lineage_invalid")
+    child = conn.execute("SELECT s.id FROM sessions s JOIN maya_session_owners_v1 o "
+        "ON o.session_id=s.id WHERE s.parent_session_id=? AND o.parent_session_id=?",
+        (target, target)).fetchall()
+    if len(child) != 1:
+        raise GovernanceBoundaryError("governance.switch_lineage_invalid")
+    source = child[0][0]
+    for session, parent, status, reason in ((target, None, "active", None),
+                                            (source, target, "ended", "session_switch")):
+        row = conn.execute("SELECT s.user_id,s.parent_session_id,s.ended_at,s.end_reason,s.archived,"
+            "s.source,o.lifecycle_status,o.parent_session_id,o.principal,o.classification,"
+            "o.binding_version,o.instance_id,o.database_id FROM sessions s "
+            "JOIN maya_session_owners_v1 o ON o.session_id=s.id WHERE s.id=?", (session,)).fetchone()
+        if (row is None or row[0] != binding.owner.actor_id or row[1] != parent
+                or (row[2] is None) != (status == "active") or row[3] != reason
+                or tuple(row[4:]) != (0, "maya-governed-candidate", status, parent,
+                    binding.owner.actor_id, binding.owner.data_classification, binding.binding_version,
+                    binding.instance_id, str(binding.database))):
+            raise GovernanceBoundaryError("governance.switch_lineage_invalid")
+    history = _history(conn, source, target)
+    for row, operation, session, old, new in (
+            (history[0], "create", target, 0, 1), (history[1], "reset", source, 1, 2)):
+        if (tuple(row[2:9]) != (binding.owner.actor_id, binding.binding_version, operation,
+                                session, old, new, "caller_acknowledged")
+                or row[11] != "sha256:" + _digest(row[0].encode())):
+            raise GovernanceBoundaryError("governance.switch_lineage_invalid")
+    if not history[0][9] < history[1][9] < current[9]:
+        raise GovernanceBoundaryError("governance.switch_lineage_invalid")
+    return source, history, tuple(current)
+
+
+class CandidateSwitchPreparation:
+    contract = CONTRACT
+
+    def __init__(self, switch, *, acknowledgement, gateway_runner):
+        from gateway.run import GatewayRunner
+        from .session_handoff import CandidateConversationExecutorFactory
+        if (type(switch) is not CandidateNativeSessionSwitch or acknowledgement != ACKNOWLEDGEMENT
+                or type(gateway_runner) is not GatewayRunner
+                or gateway_runner is not switch.preparation._runner
+                or gateway_runner._session_db is not switch.database
+                or type(getattr(gateway_runner, "_maya_conversation_executor_factory", None)) is not CandidateConversationExecutorFactory
+                or gateway_runner._maya_conversation_executor_factory._runner is not gateway_runner
+                or getattr(switch.store, "_maya_switch_preparation", None) is not None
+                or getattr(gateway_runner, "_maya_switch_preparation", None) is not None):
+            raise GovernanceBoundaryError("governance.switch_preparation_invalid")
+        self.switch = switch
+        self.store = switch.store
+        self.coordinator = switch.coordinator
+        self._runner = gateway_runner
+        self._pid = getpid()
+        self._lock = Lock()
+        self._phase = "idle"
+        self._current = None
+        self._history = None
+        self._cleanup_authority = None
+        self._confirmed = None
+        self.store._maya_switch_preparation = self
+        gateway_runner._maya_switch_preparation = self
+
+    def _registered(self):
+        if (self.switch._limits != self.switch.limits() or self._pid != getpid()
+                or self.store._db is not self.switch.database
+                or getattr(self.store, "_maya_switch_coordinator", None) is not self.switch
+                or getattr(self.store, "_maya_create_coordinator", None) is not self.coordinator
+                or self.switch.coordinator is not self.coordinator
+                or getattr(self.store, "_maya_switch_preparation", None) is not self
+                or getattr(self._runner, "_maya_switch_preparation", None) is not self
+                or self._runner is not self.switch.preparation._runner
+                or self._runner._session_db is not self.switch.database):
+            raise GovernanceBoundaryError("governance.switch_preparation_invalid")
+
+    def _confirmation(self, conn, target):
+        source, history, current = validate_switch_lineage(conn, self.switch.binding, target)
+        return (target, source, self.switch.binding.route_slot, self.switch.binding.database,
+                self.switch.binding.instance_id, history, current)
+
+    def require_confirmation(self, reader, target):
+        self._registered()
+        if (self._phase != "idle" or self._current is not None or self._confirmed is None
+                or reader is not getattr(self.store, "_maya_published_reader", None)
+                or reader.coordinator is not self.coordinator
+                or self._confirmed != self._confirmation(self.switch.database._conn, target)):
+            raise GovernanceBoundaryError("governance.switch_confirmation_required")
+
+    def _bound(self, authority, expected, *, projection=True):
+        self._registered()
+        self.switch.require(self.store)
+        d = authority.descriptor
+        conn = self.switch.database._conn
+        generation, routes, raw = (self.coordinator._state_in_transaction(conn) if conn.in_transaction
+                                  else self.coordinator._state(conn))
+        source, history, current = validate_switch_lineage(conn, self.switch.binding, d.target_session, expected)
+        if (source != d.source_session or history != self._history
+                or history[1][0] != d.prior_reset_correlation or current[0] != d.correlation_id
+                or current[1] != d.digest or current[9] != generation or current[10] != _digest(raw)
+                or routes.get(d.route_slot) != {"session_id": d.target_session, "version": 3}
+                or (projection and self.coordinator.index.read_bytes() != raw)
+                or conn.execute("SELECT 1 FROM maya_session_transitions_v1 WHERE correlation_id<>? "
+                                "AND state<>'caller_acknowledged' LIMIT 1", (d.correlation_id,)).fetchone()):
+            raise GovernanceBoundaryError("governance.switch_receipt_invalid")
+        return raw
+
+    def _audit(self, authority, operation, decision):
+        d = authority.descriptor
+        try:
+            self.switch.binding.audit.write(AuditRecord(event_type="outcome.session_switch",
+                decision=decision, reason_code="governance." + operation, actor_id=d.principal,
+                capability="session.transition", operation=operation,
+                target="sha256:" + _digest(d.route_slot.encode()), data_classification=d.classification,
+                metadata={"contract": CONTRACT, "descriptor_digest": d.digest,
+                          "qualification": "source_candidate_only"}))
+        except Exception:
+            raise GovernanceBoundaryError("governance.switch_audit_unavailable") from None
+
+    def _commit(self, conn):
+        conn.commit()
+
+    def _change(self, authority, old, new):
+        conn = self.switch.database._conn
+        with authority.lock:
+            authority.check()
+            conn.execute("BEGIN IMMEDIATE")
+            try:
+                self._bound(authority, old)
+                changed = conn.execute("UPDATE maya_session_transitions_v1 SET state=? "
+                    "WHERE correlation_id=? AND descriptor_digest=? AND state=?",
+                    (new, authority.descriptor.correlation_id, authority.descriptor.digest, old))
+                if changed.rowcount != 1:
+                    raise GovernanceBoundaryError("governance.switch_receipt_invalid")
+                authority.check()
+                self._commit(conn)
+            except BaseException:
+                conn.rollback()
+                raise
+
+    def _publish(self, authority):
+        with self.coordinator._exclusive(), self.store._lock, self.switch.database._lock, authority.lock:
+            authority.authorize()
+            raw = self._bound(authority, "committed_pending_projection", projection=False)
+            self.coordinator._publish(raw)
+            authority.check()
+            self._change(authority, "committed_pending_projection", "projection_verified")
+            self.switch.authorize("session.transition", "switch", authority.descriptor.route_slot, authority.descriptor)
+            authority.check()
+            self._audit(authority, "switch_published", "allow")
+            authority.check()
+            self._change(authority, "projection_verified", "published_pending_caller")
+            self.store._entries = {}
+            self.store._loaded = False
+
+    def _acknowledge(self, authority):
+        if self._phase != "acknowledging" or self._current is not authority:
+            raise GovernanceBoundaryError("governance.switch_caller_invalid")
+        with self.coordinator._exclusive(), self.store._lock, self.switch.database._lock, authority.lock:
+            authority.check()
+            self._bound(authority, "published_pending_caller")
+            self.switch.authorize("session.transition", "acknowledge_switch",
+                                  authority.descriptor.route_slot, authority.descriptor)
+            authority.check()
+            self._runner._clear_owned_switch_security_candidate(self)
+            if self._cleanup_authority is not authority:
+                raise GovernanceBoundaryError("governance.switch_cleanup_incomplete")
+            authority.check()
+            self._audit(authority, "acknowledge_switch", "allow")
+            authority.check()
+            self._change(authority, "published_pending_caller", "caller_acknowledged")
+            self._bound(authority, "caller_acknowledged")
+            return self._confirmation(self.switch.database._conn, authority.descriptor.target_session)
+
+    def _quarantine(self, authority):
+        if (self._phase != "failed" or self._current is not authority
+                or authority.thread != get_ident() or authority.task is not _current_task()):
+            raise GovernanceBoundaryError("governance.switch_cleanup_invalid")
+        try:
+            self._audit(authority, "quarantine_switch", "deny")
+        except GovernanceBoundaryError:
+            pass
+        with self.coordinator._exclusive(), self.store._lock, self.switch.database._lock:
+            conn = self.switch.database._conn
+            for state in ("published_pending_caller", "caller_acknowledged"):
+                try:
+                    self._bound(authority, state)
+                except GovernanceBoundaryError:
+                    continue
+                conn.execute("BEGIN IMMEDIATE")
+                try:
+                    self._bound(authority, state)
+                    changed = conn.execute("UPDATE maya_session_transitions_v1 SET state='caller_quarantined' "
+                        "WHERE correlation_id=? AND descriptor_digest=? AND state=?",
+                        (authority.descriptor.correlation_id, authority.descriptor.digest, state))
+                    if changed.rowcount != 1:
+                        raise GovernanceBoundaryError("governance.switch_cleanup_invalid")
+                    conn.commit()
+                except BaseException:
+                    conn.rollback()
+                    raise
+                return
+
+    @contextmanager
+    def prepare(self, store, identity, target):
+        self._registered()
+        self.switch.require(store)
+        if _session_write.get() is not None or not self._lock.acquire(blocking=False):
+            raise GovernanceBoundaryError("governance.switch_preparation_invalid")
+        try:
+            self._confirmed = None
+            self._cleanup_authority = None
+            with self.switch.authenticated_switch(identity, target) as authority:
+                # Capture approved historical receipts before the lifecycle change.
+                with self.coordinator._exclusive(), self.store._lock, self.switch.database._lock:
+                    authority.authorize()
+                    _, _, _, source, parent, correlation = self.switch.source(self.switch.database._conn)
+                    if (source, parent, correlation) != (authority.descriptor.source_session,
+                            authority.descriptor.target_session, authority.descriptor.prior_reset_correlation):
+                        raise GovernanceBoundaryError("governance.switch_receipt_invalid")
+                    self._history = _history(self.switch.database._conn, source, parent)
+                store.switch_owned_session_candidate(authority)
+                self._publish(authority)
+                self._current = authority
+                self._phase = "preparing"
+                try:
+                    yield MappingProxyType({"session_id": authority.descriptor.target_session,
+                        "source_session": authority.descriptor.source_session,
+                        "state": "published_pending_caller", "dispatch_allowed": False})
+                    self._phase = "acknowledging"
+                    confirmation = self._acknowledge(authority)
+                except BaseException:
+                    self._phase = "failed"
+                    try:
+                        self._quarantine(authority)
+                    except BaseException:
+                        pass  # Preserve original failure; unresolved state remains blocked.
+                    raise
+        except BaseException:
+            self._confirmed = None
+            raise
+        finally:
+            self._current = None
+            self._phase = "idle"
+            self._history = None
+            self._cleanup_authority = None
+            self._lock.release()
+        self._confirmed = confirmation
