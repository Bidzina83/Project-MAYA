+    def _clear_owned_switch_security_candidate(self, preparation) -> None:
+        """Detach old route state synchronously; never launch eviction workers."""
+        from collections import OrderedDict
+        from hermes_cli.middleware import mandatory_middleware_enabled, MandatoryMiddlewareError
+        from project_maya.hermes_plugins.switch_publication import CandidateSwitchPreparation
+        from tools import approval, slash_confirm
+        if (not mandatory_middleware_enabled() or type(preparation) is not CandidateSwitchPreparation
+                or getattr(self, "_maya_switch_preparation", None) is not preparation
+                or preparation._runner is not self or self._session_db is not preparation.switch.database
+                or preparation._phase != "acknowledging" or preparation._current is None
+                or getattr(preparation.store, "_maya_switch_preparation", None) is not preparation):
+            raise MandatoryMiddlewareError("governance.switch_security_invalid")
+        preparation._current.check()
+        key = preparation.switch.binding.route_slot
+        try:
+            running = getattr(self, "_running_agents", None)
+            if type(running) is not dict or key in running:
+                raise ValueError("active or unqualified route")
+            approval.clear_session(key)
+            approval.unregister_gateway_notify(key)
+            slash_confirm.clear(key)
+            names = ("_pending_approvals", "_update_prompt_pending", "_pending_skills_reload_notes",
+                     "_session_model_overrides", "_session_reasoning_overrides", "_voice_mode",
+                     "_pending_messages", "_last_resolved_model")
+            for name in names:
+                state = getattr(self, name, None)
+                if state is not None:
+                    if type(state) is not dict:
+                        raise ValueError("invalid route state")
+                    state.pop(key, None)
+                    if name == "_last_resolved_model":
+                        state.pop("*", None)
+                    if key in state:
+                        raise ValueError("uncleared route state")
+            cache = getattr(self, "_agent_cache", None)
+            lock = getattr(self, "_agent_cache_lock", None)
+            if cache is not None:
+                if type(cache) not in (dict, OrderedDict) or lock is None:
+                    raise ValueError("unqualified cache")
+                with lock:
+                    cache.pop(key, None)
+                    if key in cache:
+                        raise ValueError("uncleared cache")
+            elif lock is not None:
+                raise ValueError("unqualified cache")
+            with approval._lock, slash_confirm._lock:
+                if (key in approval._session_approved or key in approval._session_yolo
+                        or key in approval._pending or key in approval._gateway_queues
+                        or key in approval._gateway_notify_cbs or key in slash_confirm._pending):
+                    raise ValueError("uncleared security state")
+            preparation._current.check()
+            preparation._cleanup_authority = preparation._current
+        except MandatoryMiddlewareError:
+            raise
+        except Exception:
+            raise MandatoryMiddlewareError("governance.switch_security_failed") from None
 
