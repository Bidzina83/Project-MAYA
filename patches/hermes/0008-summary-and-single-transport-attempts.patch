+def require_single_attempt_client(client: Any) -> Any:
+    """Reject SDK-managed retries instead of authorizing multiple HTTP attempts.
+
+    The release must supply qualified OpenAI/Anthropic clients with retries
+    disabled. Unknown wrappers are not silently assumed to be single-attempt.
+    """
+    if _mandatory_enabled:
+        retries = getattr(client, "max_retries", None)
+        if type(retries) is not int or retries != 0:
+            raise MandatoryMiddlewareError("sdk_retries_enabled")
+    return client
+
+
