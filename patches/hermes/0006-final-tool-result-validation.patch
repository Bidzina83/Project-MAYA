+def run_tool_result_middleware(tool_name: str, args: Dict[str, Any], result: Any, **context: Any) -> Any:
+    """Validate the final tool result after execution and result transforms.
+
+    This candidate fork extension reuses the native middleware registry. The
+    required validator is the last callback and receives no execution callback.
+    """
+    if not _mandatory_enabled:
+        return result
+    try:
+        if not validate_mandatory_middleware():
+            raise MandatoryMiddlewareError("gate_missing")
+        required = _mandatory_callbacks[TOOL_RESULT_MIDDLEWARE]
+        callbacks = _get_middleware_callbacks(TOOL_RESULT_MIDDLEWARE)
+        callbacks = [callback for callback in callbacks if callback != required] + [required]
+        effective_args = deepcopy(args)
+        for callback in callbacks:
+            result = callback(**middleware_payload(
+                tool_name=tool_name, args=deepcopy(effective_args), result=result, **context,
+            ))
+            if not validate_mandatory_middleware():
+                raise MandatoryMiddlewareError("gate_missing")
+        return result
+    except MandatoryMiddlewareError as exc:
+        raise MandatoryMiddlewareError(str(exc)) from None
+    except Exception:
+        raise MandatoryMiddlewareError("callback_failed") from None
+
+
