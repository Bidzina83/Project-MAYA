diff --git a/source/gateway/session.py b/source/gateway/session.py
--- a/source/gateway/session.py
+++ b/source/gateway/session.py
@@ -817,1 +817,25 @@
+    @contextmanager
+    def prepare_owned_session_candidate(self, identity):
+        from hermes_cli.middleware import MandatoryMiddlewareError
+        try:
+            from project_maya.hermes_plugins.caller_preparation import CandidateCallerPreparation
+            host = getattr(self, "_maya_caller_preparation", None)
+            if type(host) is not CandidateCallerPreparation:
+                raise MandatoryMiddlewareError("caller_preparation_unqualified")
+            scope = host.prepare(self, identity)
+            receipt = scope.__enter__()
+        except Exception:
+            raise MandatoryMiddlewareError("caller_preparation_failed") from None
+        try:
+            yield receipt
+        except BaseException:
+            import sys
+            scope.__exit__(*sys.exc_info())
+            raise
+        else:
+            try:
+                scope.__exit__(None, None, None)
+            except Exception:
+                raise MandatoryMiddlewareError("caller_preparation_failed") from None
+
     def _maya_session_reader(self):
